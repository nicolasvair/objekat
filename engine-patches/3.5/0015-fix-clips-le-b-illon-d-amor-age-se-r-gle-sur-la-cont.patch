@@ -988,32 +1067,19 @@ std::unique_ptr<tracktion::graph::Node> createNodeForClips (EditItemID trackID,
             tail = std::max (tail, TimeDuration::fromSeconds (laneLatencySeconds * 2.0));
         }
 
