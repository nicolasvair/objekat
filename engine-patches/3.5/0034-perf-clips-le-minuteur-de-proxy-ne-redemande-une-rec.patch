Subject: [PATCH] =?UTF-8?q?perf(clips)=20:=20le=20minuteur=20de=20proxy=20?=
 =?UTF-8?q?ne=20redemande=20une=20reconstruction=20que=20si=20le=20fichier?=
 =?UTF-8?q?=20de=20lecture=20a=20chang=C3=A9?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

AudioClipBase::timerCallback repasse ~25 ms après TOUTE modification d'un clip et appelait
restartPlayback() sans condition — même pour un clip sans proxy dont le graphe joue déjà
l'original. Une coupe en lecture payait donc une seconde reconstruction, amortie 120 ms plus
tard, et un bloc de silence de plus. Désormais : seulement si le proxy a changé (hors premier
passage d'un clip simple) ou si on attendait son rendu. Lecture inversée vérifiée (sonde).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../model/clips/tracktion_AudioClipBase.cpp       | 15 +++++++++++++++
 .../model/clips/tracktion_AudioClipBase.h         |  2 ++
 2 files changed, 17 insertions(+)

diff --git a/modules/tracktion_engine/model/clips/tracktion_AudioClipBase.cpp b/modules/tracktion_engine/model/clips/tracktion_AudioClipBase.cpp
index 2b60720c578..d5b216edda0 100644
--- a/modules/tracktion_engine/model/clips/tracktion_AudioClipBase.cpp
+++ b/modules/tracktion_engine/model/clips/tracktion_AudioClipBase.cpp
@@ -2482,6 +2482,9 @@ void AudioClipBase::timerCallback()
     const AudioFile newProxy (getPlaybackFile());
 
     const bool proxyChanged = lastProxy != newProxy;
+    // OBJEKAT — premier passage d'un clip sans proxy (lastProxy encore vide, fichier de lecture =
+    // l'original) : le graphe joue déjà ce fichier, rien n'a changé pour lui.
+    const bool firstLookAtPlainClip = lastProxy.isNull() && newProxy == originalFile;
 
     if (proxyChanged)
     {
@@ -2506,6 +2509,7 @@ void AudioClipBase::timerCallback()
         }
 
         // poll until the proxy is ready..
+        waitingForProxyRender = true;
         startTimer (100);
         return;
     }
@@ -2514,6 +2518,17 @@ void AudioClipBase::timerCallback()
     if (! proxyChanged)
         edit.engine.getAudioFileManager().releaseFile (newProxy);
 
+    // OBJEKAT — seulement si le fichier de lecture a VRAIMENT changé pour le graphe : un proxy
+    // différent, ou un rendu qu'on attendait. Avant, TOUTE modification d'un clip (le raccourcir,
+    // le créer par une coupe…) repassait ici ~25 ms plus tard et redemandait une reconstruction
+    // sans que rien n'ait changé — une seconde reconstruction, amortie, 120 ms après la première,
+    // et un bloc de silence de plus pendant la lecture.
+    const bool playbackFileChanged = waitingForProxyRender || (proxyChanged && ! firstLookAtPlainClip);
+    waitingForProxyRender = false;
+
+    if (! playbackFileChanged)
+        return;
+
     Selectable::changed();
     edit.restartPlayback();
 }
diff --git a/modules/tracktion_engine/model/clips/tracktion_AudioClipBase.h b/modules/tracktion_engine/model/clips/tracktion_AudioClipBase.h
index 376ff0adb67..626e64823c1 100644
--- a/modules/tracktion_engine/model/clips/tracktion_AudioClipBase.h
+++ b/modules/tracktion_engine/model/clips/tracktion_AudioClipBase.h
@@ -742,6 +742,8 @@ protected:
 
     RenderManager::Job::Ptr renderJob;
     AudioFile lastProxy;
+    // OBJEKAT — vrai tant qu'on attend le rendu d'un proxy (@see timerCallback).
+    bool waitingForProxyRender = false;
 
     //==============================================================================
     /** Triggers a source or proxy render after a timeout. Call this if something changes that
