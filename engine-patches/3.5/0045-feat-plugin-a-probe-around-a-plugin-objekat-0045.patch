From 8a8b5b453c0334889a8c1cbe8981ef5cc1cd66aa Mon Sep 17 00:00:00 2001
From: vair <79313360+nicolasvair@users.noreply.github.com>
Date: Tue, 20 Oct 2026 03:41:40 +0200
Subject: [PATCH] feat(plugin): a probe around a plugin (objekat 0045)

te::Plugin::ObjProbe, installed once per instance by the host, is called by
PluginNode::process just before and just after the plugin, and only while the
plugin really processes (shouldProcessPlugin && isEnabled): a bypassed plugin
bypasses its probe with it. The host uses it for an input and an output trim
and for a K-weighted loudness measurement of what enters and leaves the plugin.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../playback/graph/tracktion_PluginNode.cpp   | 15 ++++++++
 .../plugins/tracktion_Plugin.h                | 34 +++++++++++++++++++
 2 files changed, 49 insertions(+)

diff --git a/modules/tracktion_engine/playback/graph/tracktion_PluginNode.cpp b/modules/tracktion_engine/playback/graph/tracktion_PluginNode.cpp
index 7c18de3cba1..509acf7f168 100644
--- a/modules/tracktion_engine/playback/graph/tracktion_PluginNode.cpp
+++ b/modules/tracktion_engine/playback/graph/tracktion_PluginNode.cpp
@@ -212,6 +212,15 @@ void PluginNode::process (ProcessContext& pc)
         }
     }
 
+    // Objekat — the probe around the plugin (patch 0045), only when the plugin really processes.
+    auto* objProbe = (shouldProcessPlugin && plugin->isEnabled()) ? plugin->objGetProbe() : nullptr;
+
+    if (objProbe != nullptr)
+    {
+        auto probeBuffer = toAudioBuffer (outputAudioView);
+        objProbe->objBeforePlugin (probeBuffer, sampleRate, isRendering);
+    }
+
     // Fast path for disabled plugins: skip sub-block loop and pass MIDI straight through
     if (! shouldProcessPlugin)
     {
@@ -295,6 +304,12 @@ void PluginNode::process (ProcessContext& pc)
         }
     }
 
+    if (objProbe != nullptr && plugin->isEnabled())
+    {
+        auto probeBuffer = toAudioBuffer (outputAudioView);
+        objProbe->objAfterPlugin (probeBuffer, sampleRate, isRendering);
+    }
+
    #if TRACKTION_SANITISE_PLUGIN_OUTPUT
     // Some plugins flake and add NaNs so zero these out to avoid killing all the audio downstream
     sanitise (outputAudioView);
diff --git a/modules/tracktion_engine/plugins/tracktion_Plugin.h b/modules/tracktion_engine/plugins/tracktion_Plugin.h
index c319f470413..cf4e2fc7964 100644
--- a/modules/tracktion_engine/plugins/tracktion_Plugin.h
+++ b/modules/tracktion_engine/plugins/tracktion_Plugin.h
@@ -224,6 +224,40 @@ public:
     LevelMeasurer objOutputMeasurer;
     std::atomic<bool> objOutputMeteringEnabled { false };
 
+    //==============================================================================
+    // Objekat — a probe AROUND the plugin, without an extra graph node (patch 0045).
+
+    /** Called by PluginNode::process on the block it hands the plugin: just before the plugin
+        processes it and just after. Only while the plugin REALLY processes (enabled, track
+        audible) — never in bypass, so whatever a probe does to the signal is bypassed with the
+        plugin. `isRendering` says the block belongs to an offline render: a probe may still
+        change the signal there (a gain must be heard in an export too), but must not feed
+        anything live. Both run on the audio thread: no lock, no allocation. */
+    struct ObjProbe
+    {
+        virtual ~ObjProbe() = default;
+        virtual void objBeforePlugin (juce::AudioBuffer<float>&, double sampleRate, bool isRendering) noexcept = 0;
+        virtual void objAfterPlugin  (juce::AudioBuffer<float>&, double sampleRate, bool isRendering) noexcept = 0;
+    };
+
+    /** Installs the probe, from the message thread, ONCE per plugin: a second call is refused
+        (false). The audio thread reads the raw pointer with no lock, so the probe lives exactly
+        as long as the plugin, which the graph's nodes keep alive. */
+    bool objInstallProbe (std::unique_ptr<ObjProbe> p)
+    {
+        if (p == nullptr || objProbeOwner != nullptr)
+            return false;
+
+        objProbeOwner = std::move (p);
+        objProbe.store (objProbeOwner.get(), std::memory_order_release);
+        return true;
+    }
+
+    ObjProbe* objGetProbe() const noexcept      { return objProbe.load (std::memory_order_acquire); }
+
+    std::unique_ptr<ObjProbe> objProbeOwner;
+    std::atomic<ObjProbe*> objProbe { nullptr };
+
     //==============================================================================
     /** Gives the plugin a chance to set itself up before being played.
         This won't be called concurrently with the process thread.
