@@ -1509,6 +1509,9 @@ void LoopingMidiNode::process (ProcessContext& pc)
         return;
     }
 
+    // Objekat 0049 (a) - re-arm the note-offs of the next mute (see MidiNode::processSection).
+    wasMute = false;
+
     generatorAndNoteList->processSection (pc.buffers.midi, pc.numSamples,
                                           getEditBeatRange(),
                                           getEditTimeRange(),
diff --git a/modules/tracktion_engine/playback/graph/tracktion_MidiNode.cpp b/modules/tracktion_engine/playback/graph/tracktion_MidiNode.cpp
index f802efbcc3c..80f7a49964f 100644
--- a/modules/tracktion_engine/playback/graph/tracktion_MidiNode.cpp
+++ b/modules/tracktion_engine/playback/graph/tracktion_MidiNode.cpp
@@ -135,6 +135,10 @@ void MidiNode::processSection (Node::ProcessContext& pc,
         return;
     }
 
+    // Objekat 0049 (a) - the mute is over: re-arm the note-offs of the NEXT mute. wasMute was only ever
+    // set, so from the second mute on no note-off was sent and the held note stayed stuck.
+    wasMute = false;
+
     if (! getPlayHeadState().isContiguousWithPreviousBlock() || localTime.getStart() <= 0.00001 || shouldCreateMessagesForTime)
     {
         MidiNodeHelpers::createMessagesForTime (pc.buffers.midi, sequence, localTime.getStart(),
diff --git a/modules/tracktion_engine/playback/graph/tracktion_PluginNode.cpp b/modules/tracktion_engine/playback/graph/tracktion_PluginNode.cpp
index 509acf7f168..9e1234caf9a 100644
--- a/modules/tracktion_engine/playback/graph/tracktion_PluginNode.cpp
+++ b/modules/tracktion_engine/playback/graph/tracktion_PluginNode.cpp
@@ -267,10 +267,15 @@ void PluginNode::process (ProcessContext& pc)
                                                                          outputAudioBuffer));
 
             // Then copy the buffers to the outputs
+            // Objekat 0049 (c) - the plugin saw its MIDI relative to the START OF THE SUB-BLOCK (input
+            // loop above) and hands it back the same way: put the sub-block's offset back so the
+            // timestamps are relative to the block again. Without it every message of a sub-block > 0
+            // moved EARLIER by the offset (128 samples = 2.67 ms) as soon as a plugin on the chain has
+            // automation (sub-blocks of 128).
             if (subBlockNum == 0)
                 outputBuffers.midi.swapWith (midiMessageArray);
             else
-                outputBuffers.midi.mergeFrom (midiMessageArray);
+                outputBuffers.midi.mergeFromWithOffset (midiMessageArray, subBlockTimeRange.getStart().inSeconds());
 
             numSamplesDone += numSamplesThisBlock;
             numSamplesLeft -= numSamplesThisBlock;
