{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "comment": "Shown by macOS the first time an audio input is opened (input.enable / the record tab). The inputs stay closed at launch.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OBJEKAT uses the microphone only when you open an audio input to record. Nothing is recorded until you ask for it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OBJEKAT solo usa el micrófono cuando abre una entrada de audio para grabar. No se graba nada hasta que usted lo pida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OBJEKAT n'utilise le micro que lorsque vous ouvrez une entrée audio pour enregistrer. Rien n'est enregistré tant que vous ne le demandez pas."
          }
        }
      }
    }
  },
  "version": "1.0"
}
