    "timeline.outsideContent.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared content no longer reaches this instance: it keeps its place and length and plays silence. Open the content to extend it, or move the instance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido compartido ya no llega a esta instancia: conserva su posición y duración y reproduce silencio. Abra el contenido para alargarlo, o mueva la instancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu partagé n'atteint plus cette instance : elle garde sa place et sa durée et joue du silence. Ouvrez le contenu pour l'allonger, ou déplacez l'instance."
          }
        }
      }
    },
