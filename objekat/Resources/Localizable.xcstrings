    "synoptic.consolidate.contentHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content this instance plays, shared by every instance of the consolidated object. Double-click to open it for editing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido que reproduce esta instancia, compartido por todas las instancias del objeto consolidado. Doble clic para abrirlo y editarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
