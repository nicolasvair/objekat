          "stringUnit": {
            "state": "translated",
            "value": "Signal fed to the chain: stereo (2 channels)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Señal enviada a la cadena: estéreo (2 canales)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signal envoyé à la chaîne : stéréo (2 canaux)"
          }
        }
      }
    },
    "synoptic.width.warn.dryRight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: a stereo signal reaches this mono plugin. Only the left channel is processed; the right one goes through untouched. Right click the card, then Channels, to change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atención: una señal estéreo llega a este plugin mono. Solo se procesa el canal izquierdo; el derecho pasa sin tratar. Clic derecho en la tarjeta, luego Canales, para cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention : un signal stéréo arrive dans ce plugin mono. Seul le canal gauche est traité ; le droit passe sans traitement. Clic droit sur la carte, puis Canaux, pour le changer."
          }
        }
      }
    },
    "synoptic.width.warn.fold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: this plugin takes two channels in but gives one out; the stereo image is folded down. Right click the card, then Channels, to change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atención: este plugin recibe dos canales pero devuelve uno; la imagen estéreo se pliega. Clic derecho en la tarjeta, luego Canales, para cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention : ce plugin reçoit deux canaux mais n’en rend qu’un ; l’image stéréo est repliée. Clic droit sur la carte, puis Canaux, pour le changer."
          }
        }
      }
    },
    "synoptic.width.warn.leftOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: a stereo signal reaches a mono input. Only the left channel is read, and the output is built from it alone. Right click the card, then Channels, to change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atención: una señal estéreo llega a una entrada mono. Solo se lee el canal izquierdo y la salida se construye solo a partir de él. Clic derecho en la tarjeta, luego Canales, para cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention : un signal stéréo arrive sur une entrée mono. Seul le canal gauche est lu et la sortie n’est construite qu’à partir de lui. Clic droit sur la carte, puis Canaux, pour le changer."
          }
        }
      }
    },
    "synoptic.window.legend": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-click = editor · bypass · remove · “+” adds in series · “//” puts in parallel · drag = move (⌥ copy, ⌘ linked copy to another object)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doble clic = editor · bypass · quitar · «+» añade en serie · «//» pone en paralelo · arrastrar = mover (⌥ copiar, ⌘ copia vinculada a otro objeto)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-clic = éditeur · bypass · retrait · « + » ajout en série · « // » mise en parallèle · glisser = déplacer (⌥ copie, ⌘ copie liée vers un autre objet)."
          }
        }
      }
    },
