    "export.renderInBackground.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project stays playable and editable during the export, but preparing it reloads every plugin: on a large project the app freezes for several seconds before the render starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto sigue siendo reproducible y editable durante la exportación, pero la preparación recarga todos los plugins: en un proyecto grande la app se congela varios segundos antes de que arranque el render."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet reste jouable et modifiable pendant l'export, mais la préparation recharge tous les plugins : sur un gros projet, l'app se fige plusieurs secondes avant que le rendu démarre."
          }
        }
      }
    },
