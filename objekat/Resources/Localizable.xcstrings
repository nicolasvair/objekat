    "diskUsage.confirm.elsewhere.one": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d ticked file is used by other versions of the folder (%@). Those versions will show a missing file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%d archivo marcado lo usan otras versiones de la carpeta (%@). Esas versiones mostrarán un archivo que falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d fichier coché est utilisé par d'autres versions du dossier (%@). Ces versions afficheront un fichier manquant."
          }
        }
      }
    },
    "diskUsage.confirm.elsewhere.other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d ticked files are used by other versions of the folder (%@). Those versions will show missing files."
          }
