    "sendBake.info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consolidating bakes the chain into the wave: these sends can no longer tap where they are.\n\n%@\n\nFolding them back to post-fader keeps the send (its level and its curve); deleting removes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consolidar fija la cadena en la onda: estos envíos ya no pueden tomar su señal donde están.\n\n%@\n\nVolver a colocarlos después del fader conserva el envío (su nivel y su curva); eliminarlos lo quita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consolider fige la chaîne dans l'onde : ces envois ne peuvent plus prendre leur signal là où ils sont.\n\n%@\n\nLes replacer après le fader garde l'envoi (son niveau et sa courbe) ; les supprimer le retire."
          }
        }
      }
    },
    "sendBake.line": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@ (%@)"
