          }
        }
      }
    },
    "synoptic.consolidate.contentOpen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content open for editing. Double-click to validate it (the shared wave is re-baked; the instance's own FX and mix are never part of it)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenido abierto para edición. Doble clic para validarlo (la onda compartida se recalcula; los efectos y la mezcla propios de la instancia nunca forman parte de ella)."
          }
        },
        "fr": {
