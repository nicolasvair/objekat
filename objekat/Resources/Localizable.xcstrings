    "stem.choose.info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected objects aren't all on the same bus. A group is a submix: it leaves through a single stem, and everything inside it will follow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los objetos seleccionados no están todos en el mismo bus. Un grupo es una submezcla: sale por un solo stem, y todo su contenido lo seguirá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les objets sélectionnés ne sont pas tous sur le même bus. Un groupe est un sous-mix : il sort par un seul stem, et tout son contenu le suivra."
          }
        }
      }
    },
