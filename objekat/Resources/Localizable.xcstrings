        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%d archivos marcados los usan otras versiones de la carpeta (%@). Esas versiones mostrarán archivos que faltan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d fichiers cochés sont utilisés par d'autres versions du dossier (%@). Ces versions afficheront des fichiers manquants."
          }
        }
