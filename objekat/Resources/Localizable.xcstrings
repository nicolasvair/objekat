    "flacArchive.changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project changed during the conversion: the FLAC files written were not applied. Run the conversion again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto cambió durante la conversión: los archivos FLAC escritos no se aplicaron. Vuelva a lanzar la conversión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet a changé pendant la conversion : les fichiers FLAC écrits n'ont pas été appliqués. Relancez la conversion."
          }
        }
      }
    },
    "flacArchive.confirm.info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld WAV file(s) of the project folder (%@) will be converted with no loss, then the project will point at the FLACs and be marked as modified. The original WAVs stay where they are: after saving, the clean-up of unused files can move them to the Trash. Files outside the project folder are not touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld archivo(s) WAV de la carpeta del proyecto (%@) se convertirán sin pérdida; después el proyecto apuntará a los FLAC y se marcará como modificado. Los WAV originales se quedan donde están: tras guardar, la limpieza de archivos sin usar puede enviarlos a la papelera. Los archivos fuera de la carpeta del proyecto no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichier(s) WAV du dossier du projet (%@) seront convertis sans perte, puis le projet pointera vers les FLAC et sera marqué comme modifié. Les WAV d'origine restent en place : après l'enregistrement, le nettoyage des fichiers inutilisés peut les mettre à la corbeille. Les fichiers hors du dossier du projet ne sont pas touchés."
          }
        }
      }
    },
    "flacArchive.confirm.kept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld other file(s) will stay WAV, because a conversion would alter them or is not possible; the details are given at the end."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld archivo(s) más se quedarán en WAV, porque una conversión los alteraría o no es posible; el detalle se da al final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld autre(s) fichier(s) resteront en WAV, car une conversion les altérerait ou n'est pas possible ; le détail sera donné à la fin."
          }
        }
      }
    },
