    "expert.match.help.playing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the output trim so the plugin leaves as loud as it entered (K-weighted, over the last 5 s played)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el trim de salida para que el plugin salga tan fuerte como entró (ponderación K, en los últimos 5 s reproducidos)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle le trim de sortie pour que le plugin sorte aussi fort qu'il est entré (pondération K, sur les 5 dernières secondes jouées)."
          }
        }
      }
    },
    "expert.match.help.stopped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play to measure: the gain match reads what is played."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduzca para medir: la igualación lee lo que suena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez la lecture pour mesurer : l'égalisation lit ce qui est joué."
          }
        }
      }
    },
    "expert.trim.drive.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag: +n dB into the plugin, −n dB out of it (half-dB steps, ⌘ for fine). Double-click: both trims back to 0."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastrar: +n dB a la entrada del plugin, −n dB a su salida (pasos de medio dB, ⌘ para afinar). Doble clic: ambos trims vuelven a 0."
          }
        },
        "fr": {
          "stringUnit": {
