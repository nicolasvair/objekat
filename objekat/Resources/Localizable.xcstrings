    "prefs.api.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a UNIX socket taking JSON-lines commands (scripts, automated tests). Nothing listens while the box is unchecked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un socket UNIX que acepta comandos en JSON-lines (scripts, pruebas automatizadas). Nada escucha mientras la casilla esté desmarcada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre une socket UNIX acceptant des commandes en JSON-lines (scripts, tests automatisés). Rien n'écoute tant que la case est décochée."
          }
        }
      }
    },
