    },
    "sendBake.preFader.info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consolidation is not possible for now: the object has a pre-fader send.\n\n%@\n\nMove the send to post-fader or delete it, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La consolidación no es posible por ahora: el objeto tiene un envío pre-fader.\n\n%@\n\nColocar el envío después del fader o eliminarlo, y volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La consolidation n'est pas possible pour le moment : l'objet a un envoi pré-fader.\n\n%@\n\nReplacer cet envoi après le fader ou le supprimer, puis recommencer."
          }
        }
      }
    },
