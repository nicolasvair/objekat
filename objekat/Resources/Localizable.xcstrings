    "help.cut.zone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cut at the hovered point (snapped to the grid)\ndrag → keeps the LEFT · drag ← keeps the RIGHT\nmultiple selection: cuts at the same instant"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cortar en el punto señalado (imantado a la rejilla)\narrastrar → conserva la IZQUIERDA · arrastrar ← conserva la DERECHA\nselección múltiple: corta en el mismo instante"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couper au point survolé (aimanté à la grille)\ndrag → garde la GAUCHE · drag ← garde la DROITE\nsélection multiple : coupe au même instant"
          }
        }
      }
    },
