    "plugins.missing.onBake.info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ uses plugins that aren't installed on this computer:\n\n%2$@\n\nIf you open it, you'll hear the sound WITHOUT those effects (raw audio): they will be removed from the content, and saving it that way would lose them for good."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ usa plugins que no están instalados en este ordenador:\n\n%2$@\n\nSi lo abres, oirás el sonido SIN esos efectos (audio en bruto): serán retirados del contenido, y guardarlo así los perdería definitivamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ utilise des plugins qui ne sont pas installés sur cet ordinateur :\n\n%2$@\n\nSi vous l'ouvrez, vous entendrez le son SANS ces effets (audio brut) : ils seront retirés du contenu, et les enregistrer ainsi les perdrait définitivement."
          }
        }
      }
    },
    "plugins.missing.onOpen.info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project “%1$@” uses plugins that aren't installed on this computer. They were removed from the objects concerned; the rest of the project opens normally.\n\n%2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto «%1$@» usa plugins que no están instalados en este ordenador. Han sido retirados de los objetos afectados; el resto del proyecto se abre con normalidad.\n\n%2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet « %1$@ » utilise des plugins qui ne sont pas installés sur cet ordinateur. Ils ont été retirés des objets concernés ; le reste du projet s'ouvre normalement.\n\n%2$@"
          }
        }
      }
    },
