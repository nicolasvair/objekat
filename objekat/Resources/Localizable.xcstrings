    "canvas.pending.mode.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching to Instant mode: apply the selection, ignore it, or stay in Selection mode?"
          }
        },
        "es": {
