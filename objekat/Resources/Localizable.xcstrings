    "diskUsage.confirm.info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be freed once the Trash is emptied. Undoing in the project fetches a file back from the Trash if it needs it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se liberarán al vaciar la papelera. Deshacer en el proyecto recupera un archivo de la papelera si vuelve a necesitarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seront libérés quand la corbeille sera vidée. Annuler dans le projet ramène un fichier depuis la corbeille s'il en a de nouveau besoin."
          }
        }
      }
    },
