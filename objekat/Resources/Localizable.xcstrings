    "dialog.dirty.info.reload": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project “%@” has unsaved changes. Reopening it reloads the last version saved on disk, and the undo history starts over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto «%@» tiene cambios sin guardar. Volver a abrirlo recarga la última versión guardada en el disco, y el historial de deshacer empieza de cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet « %@ » contient des modifications non sauvegardées. Le rouvrir recharge la dernière version enregistrée sur le disque, et l'historique d'annulation repart de zéro."
          }
        }
      }
    },
